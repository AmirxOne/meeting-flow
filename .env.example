# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://meetinghub:meetinghub@localhost:5432/meetinghub?schema=public

# ── App ─────────────────────────────────────────────────────
APP_URL=http://localhost:3100
APP_PORT=3100
NODE_ENV=development

# ── Security ────────────────────────────────────────────────
# openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=72

# ── Postgres (docker compose) ───────────────────────────────
POSTGRES_PASSWORD=meetinghub

# ── Redis (optional) ────────────────────────────────────────
# Login rate-limit: sliding window 10 attempts / 15 min per IP (shared across instances).
# Falls back to in-memory Map when unset — fine for local dev without docker.
REDIS_URL=redis://localhost:6379

# ── Timezone (all times stored as UTC instants) ─────────────
DISPLAY_TIMEZONE=Asia/Tehran

# ── Notification providers ──────────────────────────────────
# SMS: mock (log only) | kavenegar (real send via api.kavenegar.com)
NOTIFICATION_SMS_PROVIDER=mock
# Required when NOTIFICATION_SMS_PROVIDER=kavenegar:
# SMS_API_KEY=your-kavenegar-api-key
# SMS_FROM=10004346
NOTIFICATION_EMAIL_PROVIDER=mock
# Required when NOTIFICATION_EMAIL_PROVIDER=smtp:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
# Comma-separated reminder channels scheduled per participant (worker sends when due)
REMINDER_CHANNELS=IN_APP,SMS,EMAIL
SMS_FROM=50004000
EMAIL_FROM=no-reply@example.com

# ── Background worker ───────────────────────────────────────
WORKER_POLL_INTERVAL_MS=15000
# Cron fallback when standalone worker is off: POST /api/internal/worker-tick
# Header: Authorization: Bearer <secret>  or  x-worker-secret: <secret>
WORKER_TICK_SECRET=change-me

# ── Calendar sync (Google Calendar API v3) ─────────────────
# mock (log only) | google (OAuth refresh token — no UI yet)
CALENDAR_PROVIDER=mock
# Required when CALENDAR_PROVIDER=google:
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CALENDAR_TIMEZONE=Asia/Tehran

# ── Authentication ──────────────────────────────────────────
# local (email/password in DB) | ldap (directory bind + auto-provision)
AUTH_MODE=local
# Required when AUTH_MODE=ldap:
# LDAP_URL=ldap://ldap.example.com:389
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_BIND_DN=cn=readonly,dc=example,dc=com
# LDAP_BIND_PASSWORD=secret
# LDAP_USER_FILTER=(mail={{email}})
# LDAP_TLS_REJECT_UNAUTHORIZED=true
