generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ RBAC ============================

model User {
  sentRequests  MeetingRequest[] @relation("MeetingRequestRequester")
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?   @unique
  fullName     String
  passwordHash String
  avatarUrl    String?
  jobTitle     String?
  department   String?
  isActive     Boolean   @default(true)
  isSuperAdmin Boolean   @default(false)
  orgId        String?
  branchId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org             Organization?        @relation(fields: [orgId], references: [id], onDelete: SetNull)
  branch          Branch?              @relation("UserBranch", fields: [branchId], references: [id], onDelete: SetNull)
  roles           UserRole[]
  sessions        Session[]
  meetings           Meeting[]            @relation("organizer")
  createdMeetings    Meeting[]            @relation("meetingCreatedBy")
  organizedSeries    MeetingSeries[]      @relation("seriesOrganizer")
  delegatesAppointed Delegate[]           @relation("DelegateManager")
  delegateOf         Delegate[]           @relation("DelegateAssistant")
  participations  MeetingParticipant[]
  approvals       MeetingApproval[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  reminders       MeetingReminder[]
  managedBranches Branch[]             @relation("branchManager")
  managedRooms    MeetingRoom[]        @relation("roomManager")
  calendarFeedTokenHash String?  @unique
  calendarFeedCreatedAt DateTime?
  calendarSyncs         MeetingCalendarSync[]
  passwordResetTokens   PasswordResetToken[]
  totpChallenges        TwoFactorChallenge[]
  totpSecretEnc         String?
  totpEnabled           Boolean  @default(false)
  totpEnabledAt         DateTime?
  totpRecoveryHashes    String[] @default([])
  /** Per-event channel opt-out. Null = org REMINDER_CHANNELS defaults (all on). */
  notificationPrefs     Json?
  uploadedAttachments   MeetingAttachment[]
  agendaItemsOwned      MeetingAgendaItem[]
  minutesPublished      MeetingMinutes[]     @relation("minutesPublished")
  minutesApproved       MeetingMinutes[]     @relation("minutesApproved")
  attendanceMarks       MeetingParticipant[] @relation("attendanceMarkedBy")
  meetingsSecretaried   MeetingSecretary[]   @relation("meetingsSecretaried")
  topicsCreated         MeetingTopic[]       @relation("topicsCreated")
  decisionsOwned        MeetingDecision[]    @relation("decisionsOwned")
  pushSubscriptions     PushSubscription[]

  @@index([branchId])
  @@index([orgId])
  @@index([isActive])
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String   @unique
  description String?
  /// null = system role shared by all orgs; set = org-owned custom role
  orgId       String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String   @id @default(cuid())
  key   String   @unique
  name  String
  group String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Session {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String
  orgId      String?
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orgId])
  @@index([expiresAt])
}

/// One-time, time-limited password reset (local AUTH_MODE only).
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([codeHash])
}

/// Short-lived login challenge after password/LDAP bind when 2FA is on.
model TwoFactorChallenge {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ======================= Organization =======================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  legalName String?
  timezone  String   @default("Asia/Tehran")
  logoUrl   String?
  /// door-tablet display boards — admin toggle (per org)
  displayEnabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches      Branch[]
  policies      MeetingPolicy[]
  holidays      OrgHoliday[]
  users         User[]
  rooms         MeetingRoom[]
  meetings      Meeting[]
  series        MeetingSeries[]
  people        PersonDirectory[]
  delegates     Delegate[]
  auditLogs     AuditLog[]
  notifications Notification[]
  sessions      Session[]
}

/// Org-wide closed / holiday calendar days (ISO YYYY-MM-DD in the org timezone).
model OrgHoliday {
  id        String   @id @default(cuid())
  orgId     String
  dateIso   String
  name      String
  createdAt DateTime @default(now())
  createdBy String?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, dateIso])
  @@index([orgId, dateIso])
}

/// Manager appoints a user who may create meetings in the manager's name
/// and see the manager's busy times in availability (private titles stay masked).
model Delegate {
  id         String   @id @default(cuid())
  orgId      String
  managerId  String
  delegateId String
  createdAt  DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  manager  User         @relation("DelegateManager", fields: [managerId], references: [id], onDelete: Cascade)
  delegate User         @relation("DelegateAssistant", fields: [delegateId], references: [id], onDelete: Cascade)

  @@unique([managerId, delegateId])
  @@index([orgId])
  @@index([delegateId])
}

model Branch {
  id              String  @id @default(cuid())
  orgId           String
  name            String
  address         String?
  phone           String?
  latitude        Float?
  longitude       Float?
  isActive        Boolean @default(true)
  managerId       String?
  wayfindingText  String?
  mapStorageKey   String?
  mapMimeType     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id])
  manager   User?        @relation("branchManager", fields: [managerId], references: [id], onDelete: SetNull)
  users     User[]       @relation("UserBranch")
  floors    Floor[]
  rooms     MeetingRoom[]
  meetings  Meeting[]
  series    MeetingSeries[]

  @@index([orgId])
  @@index([managerId])
}

model Floor {
  id             String   @id @default(cuid())
  branchId       String
  name           String
  number         Int
  wayfindingText String?
  mapStorageKey  String?
  mapMimeType    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  rooms  MeetingRoom[]

  @@unique([branchId, number])
  @@index([branchId])
}

model MeetingRoom {
  id              String   @id @default(cuid())
  orgId           String
  branchId        String
  name            String
  capacity        Int
  description     String?
  color           String?
  isActive        Boolean  @default(true)
  isVip           Boolean  @default(false)
  displayTokenHash      String?   @unique
  displayCode           String?   @unique
  displayTokenCreatedAt DateTime?
  minDurationMin  Int      @default(15)
  maxDurationMin  Int      @default(480)
  minLeadTimeMin  Int      @default(0)
  maxAdvanceDays  Int      @default(60)
  openTime        String?
  closeTime       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Restrict)
  branch     Branch          @relation(fields: [branchId], references: [id])
  floorId    String?
  floor     Floor?  @relation(fields: [floorId], references: [id], onDelete: SetNull)
  managerId String?
  manager   User?   @relation("roomManager", fields: [managerId], references: [id], onDelete: SetNull)
  meetings   Meeting[]
  equipment  RoomEquipment[]
  exclusions RoomExclusion[]
  series     MeetingSeries[]

  /// public QR slug — /r/<slug> shows this room's agenda without login
  publicSlug String? @unique

  @@index([orgId])
  @@index([branchId])
  @@index([branchId, isActive])
  @@index([floorId])
}

model RoomEquipment {
  id        String   @id @default(cuid())
  roomId    String
  equipment String
  createdAt DateTime @default(now())

  room MeetingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, equipment])
}

model RoomExclusion {
  id        String   @id @default(cuid())
  roomId    String
  reason    String
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime @default(now())

  room MeetingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startAt, endAt])
}


// ======================= Meeting Requests (employee asks, admin schedules) =======================

model MeetingRequest {
  id          String   @id @default(cuid())
  orgId       String
  /// null = guest request (submitted via the public page, no login)
  requesterId String?
  /// guest contact info when requesterId is null
  guestName    String?
  guestPhone   String?
  guestCompany String?
  title        String
  description String?
  /// ASAP or a preferred window
  urgency     String   @default("NORMAL") // URGENT | NORMAL | FLEXIBLE
  prefFrom    DateTime?
  prefTo      DateTime?
  /// requested participants (internal users)
  participantIds String[] @default([])
  /// total head-count the requester expects (excl. themselves)
  attendeeCount Int?
  /// requester asked for a confidential meeting (title/details masked for others)
  isPrivate    Boolean  @default(false)
  /// requested recurrence (admin creates a series at scheduling time)
  /// { freq: DAILY|WEEKLY|MONTHLY, count?: 1..52 }
  recReq       Json?
  /// where the meeting should take place
  /// ONSITE = our company's rooms · OFFSITE = at the other org (e.g. همراه اول)
  venue        String   @default("ONSITE") // ONSITE | OFFSITE
  /// target organization name when OFFSITE (e.g. «همراه اول»)
  offsiteOrg   String?
  /// optional address/note for the offsite venue
  offsiteNote  String?
  /// requested external guests (name/company/phone)
  guests      Json?
  /// approximate duration in minutes the requester wants
  durationMin Int      @default(60)
  status      String   @default("OPEN") // OPEN | SCHEDULED | REJECTED | CANCELLED
  /// the meeting created from this request (once admin fixes it)
  meetingId   String?
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User?    @relation("MeetingRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([requesterId])
}

// ======================= Meetings =======================

model Meeting {
  id           String   @id @default(cuid())
  orgId        String
  title        String
  fromRequests MeetingRequest[]
  description  String?
  organizerId  String
  branchId     String?
  roomId       String?
  startAt      DateTime
  endAt        DateTime
  status       String   @default("DRAFT")
  meetingType  String   @default("INTERNAL")
  priority     String   @default("NORMAL")
  cancelReason String?
  cancelNote   String?
  meetingCode  String   @unique @default(cuid())
  isPrivate    Boolean  @default(false)
  seriesId        String?
  originalStartAt DateTime?
  isException     Boolean  @default(false)
  videoProvider   String?
  videoUrl        String?
  /** Real submitter when a delegate booked on behalf of organizerId. Null = organizer booked themselves. */
  createdById     String?
  waitlistQueuedAt DateTime?
  waitlistOfferedAt DateTime?
  waitlistOfferExpiresAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org       Organization        @relation(fields: [orgId], references: [id], onDelete: Restrict)
  organizer User                @relation("organizer", fields: [organizerId], references: [id])
  createdBy User?               @relation("meetingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  branch    Branch?             @relation(fields: [branchId], references: [id])
  room      MeetingRoom?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  participants MeetingParticipant[]
  guests       MeetingGuest[]
  approvals    MeetingApproval[]
  events       MeetingEvent[]
  reminders    MeetingReminder[]
  calendarSyncs MeetingCalendarSync[]
  series        MeetingSeries?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  attachments   MeetingAttachment[]
  agendaItems   MeetingAgendaItem[]
  secretaries   MeetingSecretary[]
  topics        MeetingTopic[]
  contentAcls   MeetingContentAcl[]
  minutes       MeetingMinutes?

  @@index([orgId])
  @@index([orgId, startAt])
  @@index([roomId, startAt, endAt])
  @@index([branchId, startAt])
  @@index([organizerId, startAt])
  @@index([createdById])
  @@index([roomId, status, startAt])
  @@index([status])
  @@index([startAt])
  @@index([seriesId, originalStartAt])
}

model MeetingSeries {
  id            String   @id @default(cuid())
  orgId         String
  organizerId   String
  branchId      String
  roomId        String?
  title         String
  description   String?
  meetingType   String   @default("INTERNAL")
  priority      String   @default("NORMAL")
  isPrivate     Boolean  @default(false)
  videoProvider String?
  videoUrl      String?
  freq          String
  interval      Int      @default(1)
  byWeekday     Int[]    @default([])
  until         DateTime?
  count         Int?
  durationMin   Int
  dtstart       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Restrict)
  organizer User         @relation("seriesOrganizer", fields: [organizerId], references: [id])
  branch    Branch       @relation(fields: [branchId], references: [id])
  room      MeetingRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  meetings  Meeting[]

  @@index([orgId])
  @@index([organizerId])
  @@index([branchId])
}

model MeetingParticipant {
  id             String   @id @default(cuid())
  meetingId      String
  userId         String
  role           String   @default("ATTENDEE")
  required       Boolean  @default(true)
  responseStatus String   @default("PENDING")
  respondedAt    DateTime?
  joinedAt       DateTime?
  leftAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// حضورغیاب توسط برگزارکننده: PRESENT | LATE | ABSENT | EXCUSED (null = ثبت‌نشده)
  attendanceStatus      String?
  attendanceMarkedAt    DateTime?
  attendanceMarkedById  String?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceMarkedBy User? @relation("attendanceMarkedBy", fields: [attendanceMarkedById], references: [id], onDelete: SetNull)

  @@unique([meetingId, userId])
  @@index([userId])
  @@index([meetingId])
}

// Company-wide people directory: internal members AND known external contacts.
// Used by participant pickers everywhere — pick from directory OR type new.
model PersonDirectory {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  kind      String   @default("INTERNAL") // INTERNAL | EXTERNAL
  email     String?
  phone     String?
  company   String?
  jobTitle  String?
  notes     String?
  // link to a User account when kind=INTERNAL and one exists
  userId    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name, company])
  @@index([orgId])
  @@index([kind])
  @@index([name])
}

/// Minutes (صورتجلسه) recorded after the meeting is in progress or completed.
model MeetingMinutes {
  id            String   @id @default(cuid())
  meetingId     String   @unique
  body          String
  /// خلاصه جلسه — independent field, editing it never touches body
  summary       String?
  /// DRAFT | PENDING_APPROVAL | FINAL
  status        String   @default("DRAFT")
  approverId    String?
  approvedAt    DateTime?
  finalizedAt   DateTime?
  publishedAt   DateTime @default(now())
  publishedById String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  meeting     Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  publishedBy User               @relation("minutesPublished", fields: [publishedById], references: [id], onDelete: Restrict)
  approver    User?              @relation("minutesApproved", fields: [approverId], references: [id], onDelete: SetNull)
  decisions   MeetingDecision[]
  topics      MeetingTopic[]
}

/// دبیران جلسه — secretary(ies) responsible for agenda & minutes
model MeetingSecretary {
  id        String   @id @default(cuid())
  meetingId String
  userId    String
  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation("meetingsSecretaried", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
}

/// موضوعات مطرح‌شده در جلسه — recorded by the secretary, NOT inferred from agenda
model MeetingTopic {
  id          String   @id @default(cuid())
  meetingId   String
  /// null = raised in-session (not on the original agenda); set = linked agenda item
  agendaItemId String?
  title       String
  /// COVERED | PARTIAL | SKIPPED
  reviewStatus String  @default("COVERED")
  notes       String?
  /// تصمیمات اتخاذشده
  decisions   String?
  /// اقدامات موردنیاز
  actions     String?
  sortOrder   Int      @default(0)
  /// OPEN = all participants; RESTRICTED = only allowedUserIds (+ section admins)
  visibility  String   @default("OPEN")
  allowedUserIds String[] @default([])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meeting  Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdBy User            @relation("topicsCreated", fields: [createdById], references: [id], onDelete: Restrict)
  minutes  MeetingMinutes?  @relation(fields: [minutesId], references: [id], onDelete: SetNull)
  minutesId String?

  @@index([meetingId, sortOrder])
}

/// Section-level confidentiality: which parts of a meeting's content are open/restricted
model MeetingContentAcl {
  id        String   @id @default(cuid())
  meetingId String
  /// AGENDA | TOPICS | SUMMARY | BODY
  section   String
  /// ALL_PARTICIPANTS | RESTRICTED | ORGANIZER_ONLY
  level     String   @default("ALL_PARTICIPANTS")
  allowedUserIds String[] @default([])
  updatedById String?
  updatedAt DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, section])
}

/// A decision captured in meeting minutes (متن، مسئول، مهلت).
model MeetingDecision {
  id        String    @id @default(cuid())
  minutesId String
  sortOrder Int
  text      String
  ownerId   String?
  dueAt     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  minutes MeetingMinutes @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  owner   User?          @relation("decisionsOwned", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([minutesId, sortOrder])
  @@index([ownerId])
}

/// Ordered agenda (دستور جلسه) for a meeting.
model MeetingAgendaItem {
  id          String   @id @default(cuid())
  meetingId   String
  sortOrder   Int
  title       String
  durationMin Int?
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([meetingId, sortOrder])
  @@index([ownerId])
}

/// Files attached to a meeting. Bytes live on disk (MEETING_ATTACHMENTS_DIR); only metadata is in the DB.
model MeetingAttachment {
  id           String   @id @default(cuid())
  meetingId    String
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String   @unique
  uploadedById String
  createdAt    DateTime @default(now())

  meeting    Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([meetingId])
  @@index([uploadedById])
}

model MeetingGuest {
  id           String    @id @default(cuid())
  meetingId    String
  name         String
  company      String?
  phone        String?
  email        String?
  notes        String?
  hostId       String?
  arrivedAt    DateTime?
  leftAt       DateTime?
  checkinCode  String?
  createdAt    DateTime  @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([email])
}

model MeetingApproval {
  id        String   @id @default(cuid())
  meetingId String
  step      Int      @default(1)
  action    String   @default("REQUESTED")
  reason    String?
  actorId   String?
  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([actorId])
}

model MeetingEvent {
  id        String   @id @default(cuid())
  meetingId String
  type      String
  data      Json?
  actorId   String?
  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
}

/// External calendar link (Google) — one row per user who received the event.
model MeetingCalendarSync {
  id              String   @id @default(cuid())
  meetingId       String
  userId          String
  provider        String
  externalEventId String
  lastSyncedAt    DateTime @default(now())
  lastError       String?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId, provider])
  @@index([meetingId])
  @@index([userId])
}

/// Per-user Google Calendar OAuth (refresh token encrypted at rest).
/** Browser Web Push subscription (opt-in). Endpoint uniquely identifies a device. */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MeetingReminder {
  id        String    @id @default(cuid())
  meetingId String
  remindAt  DateTime
  offsetMin Int
  channel   String    @default("IN_APP")
  status    String    @default("PENDING")
  sentAt    DateTime?
  lastError String?
  createdAt DateTime  @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, remindAt])
  @@index([meetingId])
  @@index([userId])
}


model Notification {
  id        String    @id @default(cuid())
  orgId     String?
  userId    String
  type      String
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([orgId])
}

model MeetingPolicy {
  id          String   @id @default(cuid())
  orgId       String
  key         String
  value       Json
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String?
  actorId   String?
  action    String
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@index([orgId, createdAt])
}

// Platform singleton rows (e.g. worker heartbeat) — key/value JSON.
model SystemMeta {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
