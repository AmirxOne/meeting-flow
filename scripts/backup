#!/usr/bin/env bash
# Dump PostgreSQL (docker compose postgres) to backups/*.sql.gz
#
# Production compose:
#   COMPOSE_FILE=docker-compose.prod.yml bash scripts/backup
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

POSTGRES_USER="${POSTGRES_USER:-meetinghub}"
POSTGRES_DB="${POSTGRES_DB:-meetinghub}"
POSTGRES_SERVICE="${POSTGRES_SERVICE:-postgres}"
BACKUP_DIR="${BACKUP_DIR:-backups}"

mkdir -p "$BACKUP_DIR"

if ! docker compose ps "$POSTGRES_SERVICE" --status running -q 2>/dev/null | grep -q .; then
  echo "[backup] postgres is not running — start: docker compose up -d postgres" >&2
  exit 1
fi

STAMP="$(date +%Y%m%d-%H%M%S)"
OUT="$BACKUP_DIR/${POSTGRES_DB}-${STAMP}.sql.gz"

echo "[backup] pg_dump $POSTGRES_DB → $OUT"
docker compose exec -T "$POSTGRES_SERVICE" pg_dump \
  -U "$POSTGRES_USER" \
  -d "$POSTGRES_DB" \
  --no-owner \
  --no-acl \
  --clean \
  --if-exists \
  | gzip > "$OUT"

BYTES="$(wc -c < "$OUT" | tr -d ' ')"
echo "[backup] done — $BYTES bytes"
echo "$OUT"
