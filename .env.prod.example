# ═══════════════════════════════════════════════════════════
#  .env.prod — تنظیمات Production (سرور کارفرما)
#  این فایل فقط نمونه است؛ مقادیر واقعی را روی سرور پر کنید
#  و هرگز commit نکنید (git-ignored).
# ═══════════════════════════════════════════════════════════

# ─── هسته ───
APP_URL=https://meeting.example.com
APP_PORT=3100
HTTPS=true

# دیتابیس — داخل docker-compose.prod خودش ست می‌شود؛
# فقط اگر پستگرس بیرونی دارید اینجا ست کنید:
# DATABASE_URL=postgresql://meetinghub:STRONG_PASS@postgres-host:5432/meetinghub?schema=public

# رمز پستگرس کانتینر (init) — الزامی برای compose
POSTGRES_PASSWORD=CHANGE_ME_STRONG

REDIS_URL=redis://redis:6379

# ─── امنیت ───
# حداقل ۳۲ نویسه تصادفی:  openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=336

# ─── احراز هویت ───
AUTH_MODE=local
# LDAP (اختیاری): LDAP_URL / LDAP_BASE_DN / LDAP_BIND_DN / LDAP_BIND_PASSWORD
# SSO (اختیاری): OIDC_ISSUER / OIDC_CLIENT_ID / OIDC_CLIENT_SECRET

# ─── worker ───
WORKER_POLL_INTERVAL_MS=15000
WORKER_STALE_MINUTES=30
WORKER_HEALTH_PORT=3101
WORKER_TICK_SECRET=

# ─── اعلان‌ها ───
REMINDER_CHANNELS=IN_APP,PUSH,EMAIL
DISPLAY_TIMEZONE=Asia/Tehran

# SMS (kavenegar | smsir | mock)
NOTIFICATION_SMS_PROVIDER=mock
SMS_FROM=

# EMAIL (smtp | mock)
NOTIFICATION_EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.com

# ─── پوش (Web Push) ───
# تولید:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ─── پیوست‌ها ───
MEETING_ATTACHMENTS_DIR=/app/data/attachments
MEETING_ATTACHMENTS_MAX_BYTES=26214400

# ─── Docker entrypoint ───
RUN_MIGRATIONS=true
