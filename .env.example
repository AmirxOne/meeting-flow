# ── Database ────────────────────────────────────────────────
# On-prem production sample: see .env.production.example
DATABASE_URL=postgresql://meetinghub:meetinghub@localhost:5432/meetinghub?schema=public

# ── App ─────────────────────────────────────────────────────
APP_URL=http://localhost:3100
APP_PORT=3100
NODE_ENV=development
# Default tenant slug when URL/host has none (login branding + platform admin)
# DEFAULT_ORG_SLUG=sample

# ── Security ────────────────────────────────────────────────
# openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=72

# ── Postgres (docker compose) ───────────────────────────────
POSTGRES_PASSWORD=meetinghub

# ── Redis (optional) ────────────────────────────────────────
# Login rate-limit: sliding window 10 attempts / 15 min per IP (shared across instances).
# Falls back to in-memory Map when unset — fine for local dev without docker.
REDIS_URL=redis://localhost:6379

# ── Timezone (all times stored as UTC instants) ─────────────
DISPLAY_TIMEZONE=Asia/Tehran

# ── Notification providers ──────────────────────────────────
# SMS: mock (log only, default for local) | kavenegar (real send)
NOTIFICATION_SMS_PROVIDER=mock
# Pilot (real send): NOTIFICATION_SMS_PROVIDER=kavenegar
# SMS_API_KEY=your-kavenegar-api-key
# SMS_FROM=10004346
# Optional قالبکد — if set, uses verify/lookup.json (token=offset, token2=title)
# SMS_TEMPLATE=mehrsa-reminder
NOTIFICATION_EMAIL_PROVIDER=mock
# Production SMTP (HTML RTL templates for invite / reminder / minutes are built in-app):
# NOTIFICATION_EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
# Comma-separated org channels (IN_APP,SMS,EMAIL,PUSH). Profile prefs default on from this; users can turn a channel off.
REMINDER_CHANNELS=IN_APP,SMS,EMAIL,PUSH

# ── Web Push (VAPID) ────────────────────────────────────────
# Optional. Generate keys: npx web-push generate-vapid-keys
# Without these keys, profile opt-in is hidden and no push is sent.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:noreply@example.com
SMS_FROM=50004000
EMAIL_FROM=no-reply@example.com

# ── Sentry (errors: Next client/server + worker) ────────────
# Leave unset in local dev — SDK stays off. Production: set DSN.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# Off by default when NODE_ENV=development or unset (worker:dev). Opt-in:
# SENTRY_ENABLE_DEV=1
# Force on/off anywhere: SENTRY_ENABLED=1 | 0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
# Optional source maps on `pnpm build` (build still succeeds without these):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ── Background worker ───────────────────────────────────────
WORKER_POLL_INTERVAL_MS=15000
# Alert in admin if no worker tick for this many minutes (default 5)
WORKER_STALE_MINUTES=5
# Worker process health HTTP (docker healthcheck) — 127.0.0.1 only
WORKER_HEALTH_PORT=3101
# Cron fallback when standalone worker is off: POST /api/internal/worker-tick
# Header: Authorization: Bearer <secret>  or  x-worker-secret: <secret>
WORKER_TICK_SECRET=change-me

# ── Calendar sync (Google Calendar API v3) ─────────────────
# mock (log only + mock OAuth connect) | google (per-user OAuth) | outlook
CALENDAR_PROVIDER=mock
# App credentials only — refresh tokens are stored per user (encrypted) in the DB.
# Required for real Google OAuth when CALENDAR_PROVIDER=google:
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# Redirect URI: {APP origin}/api/calendar/google/callback
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CALENDAR_TIMEZONE=Asia/Tehran

# ── Outlook / Microsoft Graph (independent of CALENDAR_PROVIDER) ─
# Per-user OAuth. If credentials are missing, profile connect uses mock.
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
# OUTLOOK_TENANT=common
# Redirect URI: {APP origin}/api/calendar/outlook/callback
# OUTLOOK_CALENDAR_ID=calendar

# ── Authentication ──────────────────────────────────────────
# Comma-separated methods. Examples:
#   local              password in DB (default)
#   ldap               directory bind (replaces local password)
#   sso                browser OIDC only (Microsoft Entra ID)
#   local,sso          password form + «ورود با حساب سازمانی»
#   ldap,sso           LDAP bind + SSO button
# TOTP 2FA is per-user in Mehrsa. After LDAP bind or SSO, if totpEnabled,
# the authenticator code is still required.
AUTH_MODE=local
# Required when AUTH_MODE includes ldap:
# LDAP_URL=ldap://ldap.example.com:389
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_BIND_DN=cn=readonly,dc=example,dc=com
# LDAP_BIND_PASSWORD=secret
# LDAP_USER_FILTER=(mail={{email}})
# LDAP_TLS_REJECT_UNAUTHORIZED=true

# ── SSO / OIDC (Microsoft Entra ID) ─────────────────────────
# Register a web app in Entra. Redirect URI:
#   {APP_URL}/api/auth/sso/callback
# Token optional claim: groups (security groups) and/or app roles.
# OIDC_TENANT=organizations
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=https://login.microsoftonline.com/organizations/v2.0
# OIDC_SCOPES=openid profile email User.Read
# OIDC_BUTTON_LABEL=ورود با حساب سازمانی
# Group object-id or display name → Mehrsa role key (JSON or comma pairs):
# OIDC_GROUP_ROLE_MAP=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee:ADMIN,HR Managers:BRANCH_MANAGER
# Mapping can also be edited in admin/settings (overrides env when saved).

# ── Meeting attachments (local disk; swap for S3 later) ────
# Path is relative to the process working directory unless absolute.
MEETING_ATTACHMENTS_DIR=./data/attachments
# Default 10 MiB
MEETING_ATTACHMENTS_MAX_BYTES=10485760
