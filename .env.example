# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://meetinghub:meetinghub@localhost:5432/meetinghub?schema=public

# ── App ─────────────────────────────────────────────────────
APP_URL=http://localhost:3100
APP_PORT=3100
NODE_ENV=development

# ── Security ────────────────────────────────────────────────
# openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=72

# ── Postgres (docker compose) ───────────────────────────────
POSTGRES_PASSWORD=meetinghub

# ── Redis (optional; used for rate-limiting & queue locks) ──
# REDIS_URL=redis://localhost:6379

# ── Timezone (all times stored as UTC instants) ─────────────
DISPLAY_TIMEZONE=Asia/Tehran

# ── Notification providers ──────────────────────────────────
# mock | console  (dev). For production implement SmsProvider/EmailProvider adapters.
NOTIFICATION_SMS_PROVIDER=mock
NOTIFICATION_EMAIL_PROVIDER=mock
SMS_FROM=50004000
EMAIL_FROM=no-reply@example.com
# SMS_API_KEY=
# SMTP_URL=

# ── Background worker ───────────────────────────────────────
WORKER_POLL_INTERVAL_MS=15000
# Optional HTTP-triggered tick fallback (cron):
WORKER_TICK_SECRET=change-me
