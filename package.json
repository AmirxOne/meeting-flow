{
  "name": "meetinghub",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "assets:sync": "node scripts/sync-public-assets.mjs",
    "build": "next build",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/db-guard.mjs migrate && prisma migrate dev",
    "db:push": "node scripts/db-guard.mjs push && prisma db push",
    "db:reset": "node scripts/db-guard.mjs reset && prisma migrate reset",
    "db:seed": "node scripts/db-guard.mjs seed && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "dev": "node scripts/set-env.mjs dev && next dev -p 3100 --turbopack",
    "env:dev": "node scripts/set-env.mjs dev",
    "env:prod": "node scripts/set-env.mjs prod",
    "lint": "next lint",
    "postinstall": "node scripts/sync-public-assets.mjs",
    "start": "next start -p 3100",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration --reporter=verbose",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.5",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sentry/nextjs": "^10.72.0",
    "@sentry/node": "^10.72.0",
    "@tanstack/react-query": "^5.90.2",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "date-fns-jalali": "^4.1.0-0",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.1.1",
    "iconsax": "^0.1.1",
    "ioredis": "^5.8.0",
    "ldapjs": "^3.0.7",
    "next": "^15.5.6",
    "nextstepjs": "^2.3.0",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.63.0",
    "tailwind-merge": "^2.6.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/ldapjs": "^3.0.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.28",
    "prisma": "^6.16.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
