# ── مهرسا — نمونه env تولید / on-prem ───────────────────────
# کپی: cp .env.production.example .env
# اجرا: docker compose -f docker-compose.prod.yml up -d --build
# متغیرهای اختیاری (SSO، SMS، …) در .env.example توضیح داده شده‌اند.

# ── الزامی ────────────────────────────────────────────────────
APP_URL=https://meetings.example.com
APP_PORT=3100
NODE_ENV=production

# openssl rand -base64 48
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
SESSION_TTL_HOURS=72

POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# openssl rand -hex 32
WORKER_TICK_SECRET=REPLACE_WITH_RANDOM_SECRET

DISPLAY_TIMEZONE=Asia/Tehran

# ── Redis (الزامی در compose تولید — rate-limit مشترک) ───────
REDIS_URL=redis://redis:6379

# ── یادآورها — worker سرویس جدا باید بالا باشد ───────────────
REMINDER_CHANNELS=IN_APP,EMAIL
WORKER_POLL_INTERVAL_MS=15000
WORKER_STALE_MINUTES=5
WORKER_HEALTH_PORT=3101

# ── پیوست جلسات (volume در docker-compose.prod.yml) ─────────
MEETING_ATTACHMENTS_DIR=/app/data/attachments
MEETING_ATTACHMENTS_MAX_BYTES=10485760

# ── احراز هویت ───────────────────────────────────────────────
AUTH_MODE=local
# AUTH_MODE=local,sso  + OIDC_* — جزئیات در .env.example

# ── اعلان‌ها (mock = فقط لاگ؛ برای واقعی provider را عوض کنید) ─
NOTIFICATION_SMS_PROVIDER=mock
NOTIFICATION_EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# ── Sentry (اختیاری — خطاهای Next + worker) ─────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# ── Cron جایگزین worker (اختیاری؛ worker توصیه می‌شود) ───────
# POST /api/internal/worker-tick  Header: Authorization: Bearer $WORKER_TICK_SECRET
